# Database
DATABASE_URL="postgresql://username:password@localhost:5432/caps_db"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-here"

# Server Port
PORT=5000

# Authorized emails for initial setup (comma-separated)
# Use a full email like admin@college.edu, or a suffix rule like @gmail.com to allow any Gmail address
AUTHORIZED_ADMIN_EMAILS="@gmail.com"
AUTHORIZED_FACULTY_EMAILS="faculty1@college.edu,faculty2@college.edu"
